# Copy to .env.local for local development. Never commit real values.

# Public (safe to expose to the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only
# Pooled connection (Supabase transaction pooler, port 6543) used by the app at runtime.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres
# Direct connection (port 5432) used for migrations and seeding.
DIRECT_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
# Server-only admin key (sb_secret_...). Needed later for admin/background jobs. Never expose to the browser.
SUPABASE_SECRET_KEY=

# Integrations (added in later phases; leave empty for now)
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
# AI_PROVIDER_API_KEY=

# ── AI drafting for the plant library (optional; paid API, owner approval needed) ──
# Leave both empty to keep AI drafting off. Admins can still write plant content by hand.
# First key found wins: Gemini (free tier), then DeepSeek, then Anthropic. Or set AI_PROVIDER=gemini|deepseek|anthropic.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# AI_DRAFT_MODEL=   # defaults: gemini-flash-latest, deepseek-v4-pro, claude-sonnet-5-5

# Email (Resend). Set up with: npm run email:setup
RESEND_API_KEY=
EMAIL_FROM="Loamy <hello@loamy.farm>"
# Where new-order alerts go (defaults to the contact email in src/lib/legal.ts)
ORDER_ALERT_EMAIL=
