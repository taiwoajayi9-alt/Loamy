# Copy to .env.local for local development. Never commit real values.

# Public (safe to expose to the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only
# Pooled connection (Supabase transaction pooler, port 6543) used by the app at runtime.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres
# Direct connection (port 5432) used for migrations and seeding.
DIRECT_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
# Only needed by future admin/background jobs. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Integrations (added in later phases; leave empty for now)
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
# AI_PROVIDER_API_KEY=
