{
  "name": "loamy",
  "version": "0.1.0",
  "private": true,
  "description": "Loamy — Grow a little joy. AI-powered home gardening, learning and commerce PWA.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "db:check-rls": "tsx src/db/check-rls.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "drizzle-orm": "0.45.4",
    "next": "15.5.28",
    "postgres": "3.4.9",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "postcss": "^8",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vitest": "3.2.7"
  }
}
